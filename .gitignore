# Environment variables
.env
.env.*

# Secrets / tokens
*.token
*.key
*.pem
*.crt
secrets/
tokens/

# Docker / runtime noise
*.log
logs/
*.log.*
*.pid

# OS / editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/

# Ignore Traefik's dynamic configuration files and ACME storage, as these are generated at runtime and should not be tracked in version control.
! infra/traefik/config/*.yml
infra/traefik/config/*.json

# Ignore the CF API token file, as this contains sensitive information and should not be tracked in version control.
infra/traefik/cf_api_token.txt

# Get rid of .db files
*.db
*.sqlite
*.sqlite3

# Grafana runtime data
monitoring/grafana/

# Python bytecode and cache files
__pycache__/
*.pyc
*.pyo
*.pyd